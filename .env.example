# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=

# =========================
# Market Data APIs
# =========================
OANDA_API_KEY=
FINNHUB_API_KEY=
ALPHAVANTAGE_API_KEY=
TWELVEDATA_API_KEY=

# =========================
# AI
# =========================
AI_ENABLED=false
AI_API_KEY=
AI_MODEL=gpt-5.6-luna
AI_TEMPERATURE=0.2

# =========================
# Trading Defaults
# =========================
DEFAULT_SYMBOL=EURUSD
DEFAULT_TIMEFRAME=1h
ACCOUNT_CURRENCY=
ACCOUNT_BALANCE=1000
RISK_PER_TRADE=0.01
MAX_OPEN_POSITIONS=5

# Position sizing uses ACCOUNT_BALANCE and RISK_PER_TRADE explicitly.
# Cross-currency instruments also require an explicit quote-to-account FX rate
# at the RiskEngine call boundary; no implicit USD assumption is used.

# =========================
# Network
# =========================
REQUEST_TIMEOUT=30
MAX_RETRIES=3

# =========================
# Application
# =========================
APP_NAME=Professional Trading Bot
LOG_LEVEL=INFO
ENVIRONMENT=production
DEBUG=false
TIMEZONE=UTC

# =========================
# Continuous Telegram Scanner
# =========================
TELEGRAM_AUTO_SCANNER_ENABLED=true
TELEGRAM_AUTO_SCAN_INTERVAL_SECONDS=60
TELEGRAM_AUTO_SCAN_CHAT_IDS=
TELEGRAM_ALLOWED_USER_IDS=
TELEGRAM_AUTO_SCAN_STATE_FILE=/data/telegram_auto_scan_state.json

# =========================
# Railway / Health
# =========================
HEALTH_HOST=0.0.0.0
PORT=

# PC Worker pull mode: Railway queues work and the Windows PC pulls it over HTTPS.
# Do not configure PC_WORKER_URL when using pull mode.
PC_WORKER_MODE=pull
PC_WORKER_URL=
PC_WORKER_TOKEN=
PC_WORKER_TIMEOUT=30
PC_WORKER_HEARTBEAT_MAX_AGE=120
WORKER_QUEUE_DATABASE_PATH=/data/worker_queue.sqlite3
WORKER_QUEUE_RECOVERY_GRACE_SECONDS=30
